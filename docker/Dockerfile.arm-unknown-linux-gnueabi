# syntax=docker/dockerfile:1
# hyprcross image for arm-unknown-linux-gnueabi: Linux ARMv6 soft-float (glibc 2.39)
# hyprcross:platforms linux/amd64
# hyprcross:smoke test
FROM ubuntu:24.04

# CI passes the week: once a week the package layers below are rebuilt with that week's updates.
ARG HYPRCROSS_REFRESH=local

COPY scripts/lib.sh scripts/common.sh scripts/install.sh /hyprcross/scripts/
RUN /hyprcross/scripts/common.sh

COPY scripts/qemu.sh scripts/multiarch.sh /hyprcross/scripts/
RUN /hyprcross/scripts/qemu.sh arm

RUN /hyprcross/scripts/install.sh \
    g++-arm-linux-gnueabi

COPY scripts/hyprcross-runner /usr/local/bin/

ENV CARGO_TARGET_ARM_UNKNOWN_LINUX_GNUEABI_LINKER="arm-linux-gnueabi-gcc" \
    CARGO_TARGET_ARM_UNKNOWN_LINUX_GNUEABI_RUNNER="hyprcross-runner qemu-arm" \
    CC_arm_unknown_linux_gnueabi="arm-linux-gnueabi-gcc" \
    CXX_arm_unknown_linux_gnueabi="arm-linux-gnueabi-g++" \
    AR_arm_unknown_linux_gnueabi="arm-linux-gnueabi-ar" \
    BINDGEN_EXTRA_CLANG_ARGS_arm_unknown_linux_gnueabi="--sysroot=/usr/arm-linux-gnueabi" \
    QEMU_LD_PREFIX="/usr/arm-linux-gnueabi"

LABEL org.opencontainers.image.title="hyprcross arm-unknown-linux-gnueabi" \
      org.opencontainers.image.description="Linux ARMv6 soft-float (glibc 2.39), for hyprcross" \
      org.opencontainers.image.source="https://github.com/runepm/hyprcross" \
      org.opencontainers.image.licenses="MIT OR Apache-2.0" \
      dev.hyprcross.target="arm-unknown-linux-gnueabi"
