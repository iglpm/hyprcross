# syntax=docker/dockerfile:1
# hyprcross image for s390x-unknown-linux-gnu: Linux IBM Z (glibc 2.39)
# hyprcross:platforms linux/amd64
# hyprcross:smoke test
FROM ubuntu:24.04

# CI passes the week: once a week the package layers below are rebuilt with that week's updates.
ARG HYPRCROSS_REFRESH=local

COPY scripts/lib.sh scripts/common.sh scripts/install.sh /hyprcross/scripts/
RUN /hyprcross/scripts/common.sh

COPY scripts/qemu.sh scripts/multiarch.sh /hyprcross/scripts/
RUN /hyprcross/scripts/qemu.sh s390x
RUN /hyprcross/scripts/multiarch.sh s390x

RUN /hyprcross/scripts/install.sh \
    g++-s390x-linux-gnu

COPY scripts/hyprcross-runner /usr/local/bin/

ENV CARGO_TARGET_S390X_UNKNOWN_LINUX_GNU_LINKER="s390x-linux-gnu-gcc" \
    CARGO_TARGET_S390X_UNKNOWN_LINUX_GNU_RUNNER="hyprcross-runner qemu-s390x" \
    CC_s390x_unknown_linux_gnu="s390x-linux-gnu-gcc" \
    CXX_s390x_unknown_linux_gnu="s390x-linux-gnu-g++" \
    AR_s390x_unknown_linux_gnu="s390x-linux-gnu-ar" \
    BINDGEN_EXTRA_CLANG_ARGS_s390x_unknown_linux_gnu="--sysroot=/usr/s390x-linux-gnu" \
    QEMU_LD_PREFIX="/usr/s390x-linux-gnu" \
    PKG_CONFIG_PATH_s390x_unknown_linux_gnu="/usr/lib/s390x-linux-gnu/pkgconfig:/usr/share/pkgconfig" \
    PKG_CONFIG_ALLOW_CROSS_s390x_unknown_linux_gnu="1"

LABEL org.opencontainers.image.title="hyprcross s390x-unknown-linux-gnu" \
      org.opencontainers.image.description="Linux IBM Z (glibc 2.39), for hyprcross" \
      org.opencontainers.image.source="https://github.com/runepm/hyprcross" \
      org.opencontainers.image.licenses="MIT OR Apache-2.0" \
      dev.hyprcross.target="s390x-unknown-linux-gnu"
