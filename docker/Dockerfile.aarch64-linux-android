# syntax=docker/dockerfile:1
# hyprcross image for aarch64-linux-android: Android AArch64 (NDK r27c, API 21+)
# hyprcross:platforms linux/amd64
# hyprcross:smoke build
FROM ubuntu:24.04

# CI passes the week: once a week the package layers below are rebuilt with that week's updates.
ARG HYPRCROSS_REFRESH=local

COPY scripts/lib.sh scripts/common.sh scripts/install.sh /hyprcross/scripts/
RUN /hyprcross/scripts/common.sh

COPY scripts/android-ndk.sh /hyprcross/scripts/
RUN /hyprcross/scripts/android-ndk.sh aarch64-linux-android

ENV ANDROID_NDK_HOME="/opt/android-ndk" \
    ANDROID_NDK_ROOT="/opt/android-ndk" \
    PATH="/opt/android-ndk/toolchains/llvm/prebuilt/linux-x86_64/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin" \
    CARGO_TARGET_AARCH64_LINUX_ANDROID_LINKER="aarch64-linux-android21-clang" \
    CC_aarch64_linux_android="aarch64-linux-android21-clang" \
    CXX_aarch64_linux_android="aarch64-linux-android21-clang++" \
    AR_aarch64_linux_android="llvm-ar" \
    RANLIB_aarch64_linux_android="llvm-ranlib"

LABEL org.opencontainers.image.title="hyprcross aarch64-linux-android" \
      org.opencontainers.image.description="Android AArch64 (NDK r27c, API 21+), for hyprcross" \
      org.opencontainers.image.source="https://github.com/runepm/hyprcross" \
      org.opencontainers.image.licenses="MIT OR Apache-2.0" \
      dev.hyprcross.target="aarch64-linux-android"
