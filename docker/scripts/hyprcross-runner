#!/bin/sh
# hyprcross-runner <how> <program> [args...]
#
# The CARGO_TARGET_<TRIPLE>_RUNNER of every hyprcross image that can run its target's programs.
#   qemu-<arch>   QEMU user-mode emulation (glibc images also set QEMU_LD_PREFIX to the sysroot);
#                 runs directly when the machine already is <arch>
#   wine          Wine, with a prefix of the caller's own
#   wasmtime      Wasmtime, with the working directory preopened
#   native        directly

set -eu

if [ $# -lt 2 ]; then
    echo "usage: hyprcross-runner <qemu-ARCH|wine|wasmtime|native> <program> [args...]" >&2
    exit 2
fi

how="$1"
shift

case "$how" in
    native)
        exec "$@"
        ;;
    qemu-*)
        arch="${how#qemu-}"
        if [ "$(uname -m)" = "$arch" ]; then
            exec "$@"
        fi
        for qemu in "qemu-${arch}-static" "qemu-${arch}"; do
            if command -v "$qemu" >/dev/null 2>&1; then
                exec "$qemu" "$@"
            fi
        done
        echo "hyprcross-runner: qemu-${arch} is not installed in this image" >&2
        exit 127
        ;;
    wine)
        # Wine refuses a prefix someone else owns, and containers run as the invoking user:
        # give each user a copy of the one made when the image was built.
        prefix="${WINEPREFIX:-/tmp/hyprcross-wine-$(id -u)}"
        if [ ! -d "$prefix" ] && [ -d /opt/wine-prefix ]; then
            # Copied under a temporary name: tests running at once may race to make it.
            if cp -r /opt/wine-prefix "$prefix.tmp.$$"; then
                mv "$prefix.tmp.$$" "$prefix" 2>/dev/null || rm -rf "$prefix.tmp.$$"
            fi
        fi
        export WINEPREFIX="$prefix"
        export WINEDEBUG="${WINEDEBUG:--all}"
        exec wine "$@"
        ;;
    wasmtime)
        exec wasmtime run --dir=. "$@"
        ;;
    *)
        echo "hyprcross-runner: unknown runner '$how'" >&2
        exit 2
        ;;
esac
