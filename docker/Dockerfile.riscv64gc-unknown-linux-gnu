# syntax=docker/dockerfile:1
# hyprcross image for riscv64gc-unknown-linux-gnu: Linux RISC-V 64 (glibc 2.39)
# hyprcross:platforms linux/amd64
# hyprcross:smoke test
FROM ubuntu:24.04

# CI passes the week: once a week the package layers below are rebuilt with that week's updates.
ARG HYPRCROSS_REFRESH=local

COPY scripts/lib.sh scripts/common.sh scripts/install.sh /hyprcross/scripts/
RUN /hyprcross/scripts/common.sh

COPY scripts/qemu.sh scripts/multiarch.sh /hyprcross/scripts/
RUN /hyprcross/scripts/qemu.sh riscv64
RUN /hyprcross/scripts/multiarch.sh riscv64

RUN /hyprcross/scripts/install.sh \
    g++-riscv64-linux-gnu

COPY scripts/hyprcross-runner /usr/local/bin/

ENV CARGO_TARGET_RISCV64GC_UNKNOWN_LINUX_GNU_LINKER="riscv64-linux-gnu-gcc" \
    CARGO_TARGET_RISCV64GC_UNKNOWN_LINUX_GNU_RUNNER="hyprcross-runner qemu-riscv64" \
    CC_riscv64gc_unknown_linux_gnu="riscv64-linux-gnu-gcc" \
    CXX_riscv64gc_unknown_linux_gnu="riscv64-linux-gnu-g++" \
    AR_riscv64gc_unknown_linux_gnu="riscv64-linux-gnu-ar" \
    BINDGEN_EXTRA_CLANG_ARGS_riscv64gc_unknown_linux_gnu="--sysroot=/usr/riscv64-linux-gnu" \
    QEMU_LD_PREFIX="/usr/riscv64-linux-gnu" \
    PKG_CONFIG_PATH_riscv64gc_unknown_linux_gnu="/usr/lib/riscv64-linux-gnu/pkgconfig:/usr/share/pkgconfig" \
    PKG_CONFIG_ALLOW_CROSS_riscv64gc_unknown_linux_gnu="1"

LABEL org.opencontainers.image.title="hyprcross riscv64gc-unknown-linux-gnu" \
      org.opencontainers.image.description="Linux RISC-V 64 (glibc 2.39), for hyprcross" \
      org.opencontainers.image.source="https://github.com/runepm/hyprcross" \
      org.opencontainers.image.licenses="MIT OR Apache-2.0" \
      dev.hyprcross.target="riscv64gc-unknown-linux-gnu"
