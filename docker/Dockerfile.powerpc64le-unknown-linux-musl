# syntax=docker/dockerfile:1
# hyprcross image for powerpc64le-unknown-linux-musl: Linux POWER little-endian (musl 1.2.5, static)
# hyprcross:platforms linux/amd64
# hyprcross:smoke test

# The toolchain builds from source in a stage of its own, so its layer is reused until
# musl.sh or the base image changes.
FROM ubuntu:24.04 AS toolchain

COPY scripts/lib.sh scripts/common.sh scripts/musl.sh /hyprcross/scripts/
RUN /hyprcross/scripts/common.sh
RUN /hyprcross/scripts/musl.sh powerpc64le-linux-musl

FROM ubuntu:24.04

# CI passes the week: once a week the package layers below are rebuilt with that week's updates.
ARG HYPRCROSS_REFRESH=local

COPY scripts/lib.sh scripts/common.sh scripts/install.sh /hyprcross/scripts/
RUN /hyprcross/scripts/common.sh

COPY scripts/qemu.sh /hyprcross/scripts/
RUN /hyprcross/scripts/qemu.sh ppc64le

COPY --from=toolchain /usr/local/musl /usr/local/musl
COPY scripts/hyprcross-runner /usr/local/bin/

ENV PATH="/usr/local/musl/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin" \
    CARGO_TARGET_POWERPC64LE_UNKNOWN_LINUX_MUSL_LINKER="powerpc64le-linux-musl-gcc" \
    CARGO_TARGET_POWERPC64LE_UNKNOWN_LINUX_MUSL_RUNNER="hyprcross-runner qemu-ppc64le" \
    CC_powerpc64le_unknown_linux_musl="powerpc64le-linux-musl-gcc" \
    CXX_powerpc64le_unknown_linux_musl="powerpc64le-linux-musl-g++" \
    AR_powerpc64le_unknown_linux_musl="powerpc64le-linux-musl-ar" \
    BINDGEN_EXTRA_CLANG_ARGS_powerpc64le_unknown_linux_musl="--sysroot=/usr/local/musl/powerpc64le-linux-musl" \
    QEMU_LD_PREFIX="/usr/local/musl/powerpc64le-linux-musl"

LABEL org.opencontainers.image.title="hyprcross powerpc64le-unknown-linux-musl" \
      org.opencontainers.image.description="Linux POWER little-endian (musl 1.2.5, static), for hyprcross" \
      org.opencontainers.image.source="https://github.com/runepm/hyprcross" \
      org.opencontainers.image.licenses="MIT OR Apache-2.0" \
      dev.hyprcross.target="powerpc64le-unknown-linux-musl"
