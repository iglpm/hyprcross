# syntax=docker/dockerfile:1
# hyprcross image for powerpc64le-unknown-linux-gnu: Linux POWER little-endian (glibc 2.39)
# hyprcross:platforms linux/amd64
# hyprcross:smoke test
FROM ubuntu:24.04

# CI passes the week: once a week the package layers below are rebuilt with that week's updates.
ARG HYPRCROSS_REFRESH=local

COPY scripts/lib.sh scripts/common.sh scripts/install.sh /hyprcross/scripts/
RUN /hyprcross/scripts/common.sh

COPY scripts/qemu.sh scripts/multiarch.sh /hyprcross/scripts/
RUN /hyprcross/scripts/qemu.sh ppc64le
RUN /hyprcross/scripts/multiarch.sh ppc64el

RUN /hyprcross/scripts/install.sh \
    g++-powerpc64le-linux-gnu

COPY scripts/hyprcross-runner /usr/local/bin/

ENV CARGO_TARGET_POWERPC64LE_UNKNOWN_LINUX_GNU_LINKER="powerpc64le-linux-gnu-gcc" \
    CARGO_TARGET_POWERPC64LE_UNKNOWN_LINUX_GNU_RUNNER="hyprcross-runner qemu-ppc64le" \
    CC_powerpc64le_unknown_linux_gnu="powerpc64le-linux-gnu-gcc" \
    CXX_powerpc64le_unknown_linux_gnu="powerpc64le-linux-gnu-g++" \
    AR_powerpc64le_unknown_linux_gnu="powerpc64le-linux-gnu-ar" \
    BINDGEN_EXTRA_CLANG_ARGS_powerpc64le_unknown_linux_gnu="--sysroot=/usr/powerpc64le-linux-gnu" \
    QEMU_LD_PREFIX="/usr/powerpc64le-linux-gnu" \
    PKG_CONFIG_PATH_powerpc64le_unknown_linux_gnu="/usr/lib/powerpc64le-linux-gnu/pkgconfig:/usr/share/pkgconfig" \
    PKG_CONFIG_ALLOW_CROSS_powerpc64le_unknown_linux_gnu="1"

LABEL org.opencontainers.image.title="hyprcross powerpc64le-unknown-linux-gnu" \
      org.opencontainers.image.description="Linux POWER little-endian (glibc 2.39), for hyprcross" \
      org.opencontainers.image.source="https://github.com/runepm/hyprcross" \
      org.opencontainers.image.licenses="MIT OR Apache-2.0" \
      dev.hyprcross.target="powerpc64le-unknown-linux-gnu"
