# syntax=docker/dockerfile:1
# hyprcross image for loongarch64-unknown-linux-gnu: Linux LoongArch64 (glibc 2.39)
# hyprcross:platforms linux/amd64
# hyprcross:smoke test
FROM ubuntu:24.04

# CI passes the week: once a week the package layers below are rebuilt with that week's updates.
ARG HYPRCROSS_REFRESH=local

COPY scripts/lib.sh scripts/common.sh scripts/install.sh /hyprcross/scripts/
RUN /hyprcross/scripts/common.sh

COPY scripts/qemu.sh scripts/multiarch.sh /hyprcross/scripts/
RUN /hyprcross/scripts/qemu.sh loongarch64

RUN /hyprcross/scripts/install.sh \
    g++-14-loongarch64-linux-gnu \
    libc6-dev-loong64-cross
RUN for tool in gcc g++ cpp gcc-ar gcc-nm gcc-ranlib; do \
        ln -s "loongarch64-linux-gnu-$tool-14" "/usr/bin/loongarch64-linux-gnu-$tool"; \
    done

COPY scripts/hyprcross-runner /usr/local/bin/

ENV CARGO_TARGET_LOONGARCH64_UNKNOWN_LINUX_GNU_LINKER="loongarch64-linux-gnu-gcc" \
    CARGO_TARGET_LOONGARCH64_UNKNOWN_LINUX_GNU_RUNNER="hyprcross-runner qemu-loongarch64" \
    CC_loongarch64_unknown_linux_gnu="loongarch64-linux-gnu-gcc" \
    CXX_loongarch64_unknown_linux_gnu="loongarch64-linux-gnu-g++" \
    AR_loongarch64_unknown_linux_gnu="loongarch64-linux-gnu-ar" \
    BINDGEN_EXTRA_CLANG_ARGS_loongarch64_unknown_linux_gnu="--sysroot=/usr/loongarch64-linux-gnu" \
    QEMU_LD_PREFIX="/usr/loongarch64-linux-gnu"

LABEL org.opencontainers.image.title="hyprcross loongarch64-unknown-linux-gnu" \
      org.opencontainers.image.description="Linux LoongArch64 (glibc 2.39), for hyprcross" \
      org.opencontainers.image.source="https://github.com/runepm/hyprcross" \
      org.opencontainers.image.licenses="MIT OR Apache-2.0" \
      dev.hyprcross.target="loongarch64-unknown-linux-gnu"
