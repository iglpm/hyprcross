# syntax=docker/dockerfile:1
# hyprcross image for x86_64-unknown-freebsd: FreeBSD x86-64 (14.4 sysroot, clang)
# hyprcross:platforms linux/amd64
# hyprcross:smoke build
FROM ubuntu:24.04

# CI passes the week: once a week the package layers below are rebuilt with that week's updates.
ARG HYPRCROSS_REFRESH=local

COPY scripts/lib.sh scripts/common.sh scripts/install.sh /hyprcross/scripts/
RUN /hyprcross/scripts/common.sh

COPY scripts/freebsd.sh /hyprcross/scripts/
RUN /hyprcross/scripts/freebsd.sh x86_64 amd64

ENV CARGO_TARGET_X86_64_UNKNOWN_FREEBSD_LINKER="x86_64-unknown-freebsd-clang" \
    CC_x86_64_unknown_freebsd="x86_64-unknown-freebsd-clang" \
    CXX_x86_64_unknown_freebsd="x86_64-unknown-freebsd-clang++" \
    AR_x86_64_unknown_freebsd="llvm-ar" \
    BINDGEN_EXTRA_CLANG_ARGS_x86_64_unknown_freebsd="--sysroot=/opt/freebsd-sysroot"

LABEL org.opencontainers.image.title="hyprcross x86_64-unknown-freebsd" \
      org.opencontainers.image.description="FreeBSD x86-64 (14.4 sysroot, clang), for hyprcross" \
      org.opencontainers.image.source="https://github.com/runepm/hyprcross" \
      org.opencontainers.image.licenses="MIT OR Apache-2.0" \
      dev.hyprcross.target="x86_64-unknown-freebsd"
