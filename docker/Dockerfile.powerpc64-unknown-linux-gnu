# syntax=docker/dockerfile:1
# hyprcross image for powerpc64-unknown-linux-gnu: Linux POWER big-endian (glibc 2.39)
# hyprcross:platforms linux/amd64
# hyprcross:smoke test
FROM ubuntu:24.04

# CI passes the week: once a week the package layers below are rebuilt with that week's updates.
ARG HYPRCROSS_REFRESH=local

COPY scripts/lib.sh scripts/common.sh scripts/install.sh /hyprcross/scripts/
RUN /hyprcross/scripts/common.sh

COPY scripts/qemu.sh scripts/multiarch.sh /hyprcross/scripts/
RUN /hyprcross/scripts/qemu.sh ppc64

RUN /hyprcross/scripts/install.sh \
    g++-powerpc64-linux-gnu

COPY scripts/hyprcross-runner /usr/local/bin/

ENV CARGO_TARGET_POWERPC64_UNKNOWN_LINUX_GNU_LINKER="powerpc64-linux-gnu-gcc" \
    CARGO_TARGET_POWERPC64_UNKNOWN_LINUX_GNU_RUNNER="hyprcross-runner qemu-ppc64" \
    CC_powerpc64_unknown_linux_gnu="powerpc64-linux-gnu-gcc" \
    CXX_powerpc64_unknown_linux_gnu="powerpc64-linux-gnu-g++" \
    AR_powerpc64_unknown_linux_gnu="powerpc64-linux-gnu-ar" \
    BINDGEN_EXTRA_CLANG_ARGS_powerpc64_unknown_linux_gnu="--sysroot=/usr/powerpc64-linux-gnu" \
    QEMU_LD_PREFIX="/usr/powerpc64-linux-gnu"

LABEL org.opencontainers.image.title="hyprcross powerpc64-unknown-linux-gnu" \
      org.opencontainers.image.description="Linux POWER big-endian (glibc 2.39), for hyprcross" \
      org.opencontainers.image.source="https://github.com/runepm/hyprcross" \
      org.opencontainers.image.licenses="MIT OR Apache-2.0" \
      dev.hyprcross.target="powerpc64-unknown-linux-gnu"
